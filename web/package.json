{
  "name": "@scriberig/workspace",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx}\" \"apps/**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,js,jsx}\" \"apps/**/*.{ts,tsx,js,jsx}\"",
    "docs": "pnpm --filter @scriberig/typescript-docs run docs",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "test": "pnpm build && pnpm -r --if-present test && pnpm test:conformance",
    "build": "pnpm -r --if-present build",
    "test:conformance": "vitest run --config vitest.conformance.config.ts"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@playwright/test": "^1.56.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
